<rml>
	<head>
		<title>Netplay</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			body { width: 100%; height: 100%; }
			.np { display: flex; flex-direction: column; width: 100%; height: 100%; padding: 64dp 96dp; box-sizing: border-box; }
			.np__columns { display: flex; flex-direction: row; flex: 1 1 auto; }
			.np__column { display: flex; flex-direction: column; flex: 1 1 50%; padding-right: 48dp; }
			.np__title { font-size: 36dp; margin-bottom: 24dp; }
			.np__heading { font-size: 26dp; margin-top: 20dp; margin-bottom: 8dp; color: #ffffffcc; }
			.np__label { font-size: 18dp; color: #ffffff99; margin-top: 12dp; margin-bottom: 4dp; }
			.np__hint { font-size: 16dp; color: #ffffff88; margin-top: 6dp; }
			.np__input { display: block; width: 100%; height: 40dp; padding: 6dp 12dp; font-size: 20dp; color: #ffffff;
				background-color: #ffffff1a; border-width: 1dp; border-color: #ffffff40; border-radius: 6dp; box-sizing: border-box; }
			.np__input:focus { border-color: #ffffffcc; }
			.np__message { font-size: 20dp; margin-top: 16dp; color: #ffffffdd; }
			.np__peer { font-size: 22dp; margin-top: 6dp; }
			.np__buttons { display: flex; flex-direction: row; margin-top: 24dp; }
			.np__buttons button { width: auto; margin-right: 16dp; }
			.np__toggles { display: flex; flex-direction: row; align-items: center; margin-top: 4dp; }
			.np__toggle { font-size: 18dp; padding: 6dp 18dp; margin-right: 8dp; border-width: 1dp; border-color: #ffffff40;
				border-radius: 6dp; background-color: #ffffff12; }
			.np__toggle:hover { background-color: #ffffff2c; }
			.np__toggle--on { background-color: #ffd04070; border-color: #ffd040; }
			.np__rooms { margin-top: 12dp; max-height: 320dp; overflow-y: auto; }
			.np__room { display: flex; flex-direction: row; align-items: center; padding: 6dp 10dp; margin-bottom: 6dp;
				background-color: #ffffff10; border-radius: 6dp; }
			.np__room-name { flex: 1 1 auto; font-size: 20dp; }
			.np__room-info { font-size: 17dp; color: #ffffffaa; margin-right: 16dp; }
		</style>
	</head>
	<body>
		<div id="window" data-model="netplay_model">
			<div class="np">
				<div class="np__title">Netplay</div>

				<!-- No session yet: host or join -->
				<div class="np__columns" data-if="np_idle">
					<div class="np__column">
						<div class="np__label">Your name</div>
						<input class="np__input" type="text" maxlength="20" data-value="np_name" autofocus/>
						<div class="np__heading">Host a game</div>
						<div class="np__label">UDP port (forward it in your router, or use a relay)</div>
						<input class="np__input" type="text" maxlength="5" data-value="np_port"/>
						<div class="np__label">Relay server (leave empty for a direct connection)</div>
						<input class="np__input" type="text" maxlength="64" data-value="np_relay"/>
						<div class="np__label">Visible in the relay's room list (No: players join with the room code)</div>
						<div class="np__toggles">
							<div class="np__toggle" data-class-np__toggle--on="np_listed" data-event-click="np_set_listed(1)">Yes</div>
							<div class="np__toggle" data-class-np__toggle--on="!np_listed" data-event-click="np_set_listed(0)">No</div>
						</div>
						<div class="np__buttons">
							<button class="menu-list-item" onclick="netplay_host">
								<div class="menu-list-item__bullet">•</div>
								<div class="menu-list-item__label">Host</div>
							</button>
						</div>
					</div>
					<div class="np__column">
						<div class="np__heading">Join a game</div>
						<div class="np__label">Address of the host (IP[:port]) or of the relay server</div>
						<input class="np__input" type="text" maxlength="64" data-value="np_address"/>
						<div class="np__label">Room code (relay only; leave empty to see the relay's open rooms)</div>
						<input class="np__input" type="text" maxlength="10" data-value="np_room"/>
						<div class="np__buttons">
							<button class="menu-list-item" onclick="netplay_join">
								<div class="menu-list-item__bullet">•</div>
								<div class="menu-list-item__label">Join</div>
							</button>
						</div>
						<div class="np__rooms" data-if="np_browsing">
							<div class="np__room" data-for="r, i : np_rooms">
								<div class="np__room-name">{{r.name}}</div>
								<div class="np__room-info">{{r.players}}, {{r.state}}</div>
								<div class="np__toggle" data-event-click="np_join_room(i)">Join</div>
							</div>
							<div class="np__toggles">
								<div class="np__toggle" onclick="netplay_rooms_refresh">Refresh</div>
								<div class="np__toggle" onclick="netplay_rooms_close">Close</div>
							</div>
						</div>
						<div class="np__hint">Each PC plays with every port that is on in Setup controls (up to 8 players in all).</div>
					</div>
				</div>

				<!-- In a session: the lobby -->
				<div class="np__column" data-if="!np_idle">
					<div class="np__heading">{{np_phase}}</div>
					<div class="np__peer" data-if="np_room_code != ''">Room code: {{np_room_code}}</div>
					<div class="np__peer" data-for="peer : np_peers">{{peer}}</div>
					<div class="np__hint" data-if="np_link_summary != ''">{{np_link_summary}}</div>
					<div class="np__hint">{{np_total_players}} players in all. The host picks stage and rules in the game; the host's cheats and save are used. In game, F3 shows every player's ping.</div>
					<div class="np__buttons">
						<button class="menu-list-item" onclick="netplay_start" data-if="np_is_host" data-attrif-disabled="!np_can_start">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Start game</div>
						</button>
						<button class="menu-list-item" onclick="netplay_leave">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Leave</div>
						</button>
					</div>
				</div>

				<div class="np__message">{{np_message}}</div>
				<div class="np__buttons">
					<button class="menu-list-item" onclick="netplay_back">
						<div class="menu-list-item__bullet">•</div>
						<div class="menu-list-item__label">Back</div>
					</button>
				</div>
			</div>
		</div>
	</body>
</rml>
