<rml>
	<head>
		<title>Netplay Overlay</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			body { width: 100%; height: 100%; background-color: transparent; pointer-events: none; }
			div#window { width: 100%; height: 100%; background-color: transparent; border-width: 0dp; pointer-events: none; }
			.box { position: absolute; left: 16dp; top: 16dp; padding: 10dp 14dp; background-color: #000000b0; border-radius: 6dp; }
			.title { font-size: 16dp; color: #ffffffaa; margin-bottom: 6dp; }
			.row { display: flex; flex-direction: row; font-size: 18dp; margin-top: 3dp; }
			.name { width: 240dp; }
			.ping { width: 90dp; text-align: right; margin-right: 18dp; }
			.connection { width: 170dp; color: #ffffffcc; }
			.notices { position: absolute; left: 0dp; right: 0dp; top: 24dp; text-align: center; }
			.notice { display: inline-block; margin: 0dp 8dp; padding: 10dp 20dp; font-size: 26dp; color: #ffd0d0; background-color: #600000c8; border-radius: 6dp; }
		</style>
	</head>
	<body>
		<div id="window" data-model="netplay_model">
			<div class="notices"><div class="notice" data-for="n : np_notices">{{n}}</div></div>
			<div class="box" data-if="np_overlay_shown">
				<div class="title">Netplay (F6): ping and connection to the host</div>
				<div class="row" data-for="r : np_overlay">
					<div class="name">{{r.name}}</div>
					<div class="ping">{{r.ping}}</div>
					<div class="connection">{{r.connection}}</div>
				</div>
			</div>
		</div>
	</body>
</rml>
